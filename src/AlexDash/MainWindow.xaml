<Window x:Class="AlexDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alex Dash"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#263238">
    <DockPanel>
        <!-- HUD -->
        <Border DockPanel.Dock="Top" Background="#37474F" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LevelText" Grid.Column="0" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Text="Level 1" />
                <TextBlock x:Name="TimeText" Grid.Column="1" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Time 30" />
                <TextBlock x:Name="ScoreText" Grid.Column="2" Foreground="#FFD54F" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Score 0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Text="Alexes:" />
                    <StackPanel x:Name="LivesPanel" Orientation="Horizontal" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Play field -->
        <Grid>
            <Canvas x:Name="Field" Width="1000" Height="600" ClipToBounds="True">
                <Canvas.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,80,80" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#8BC34A">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,80,80" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#7CB342">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,40,40" />
                                            <RectangleGeometry Rect="40,40,40,40" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>

            <Border x:Name="Overlay" Background="#D9101820" CornerRadius="18" Padding="36,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="OverlayTitle" Foreground="#FFD54F" FontSize="44" FontWeight="Black"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="OverlayText" Foreground="White" FontSize="18" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" LineHeight="28" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
